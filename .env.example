# Bambulab Printer Configuration (REQUIRED)
PRINTER_HOST=192.168.1.100
PRINTER_PORT=8883

# Proxy Configuration
PROXY_BIND_HOST=0.0.0.0
PROXY_BIND_PORT=8883

# Tailscale Configuration (OPTIONAL - for remote access)
# Get your auth key from: https://login.tailscale.com/admin/settings/keys
TAILSCALE_AUTHKEY=tskey-auth-XXXXX
TAILSCALE_HOSTNAME=bambulab-proxy
